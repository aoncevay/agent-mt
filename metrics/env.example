# =============================================================================
# Metrics Evaluation Configuration
# =============================================================================
# Copy this file to .env and adjust paths for your environment.
# The .env file is gitignored and will NOT be committed.
#
# All paths can use:
#   - ~ for home directory (e.g., ~/HF_models)
#   - Environment variables (e.g., $HOME/models)
#   - Absolute paths (e.g., /mnt/data/models)
#
# IMPORTANT: All HuggingFace models must be downloaded locally.
# Internet connections are disabled during evaluation (TRANSFORMERS_OFFLINE=1).
# =============================================================================

# =============================================================================
# Base Directories
# =============================================================================

# Base directory containing all HuggingFace models
# Structure: {HF_MODELS_DIR}/{model_name}
# Example: ~/HF_models/LaBSE, ~/HF_models/metricx-24-hybrid-large-v2p6-bfloat16
HF_MODELS_DIR=~/HF_models

# Base directory for external tools (vecalign, SEGALE, etc.)
# Default: {project_root}/other_repos
# TOOLS_DIR=~/tools

# Stanza resources directory (for lemmatization in TBM)
# STANZA_RESOURCES_DIR=~/stanza_resources

# =============================================================================
# Individual Model Paths (Optional Overrides)
# =============================================================================
# Only set these if your models are not in {HF_MODELS_DIR}/{model_name}

# LaBSE model for alignment embeddings
# Default: {HF_MODELS_DIR}/LaBSE
# LABSE_MODEL_PATH=~/HF_models/LaBSE

# MetricX-24 model for translation quality evaluation
# Default: {HF_MODELS_DIR}/metricx-24-hybrid-large-v2p6-bfloat16
# METRICX_MODEL_PATH=~/HF_models/metricx-24-hybrid-large-v2p6-bfloat16

# MT5 tokenizer (used by MetricX)
# Default: {HF_MODELS_DIR}/mt5-base
# MT5_TOKENIZER_PATH=~/HF_models/mt5-base

# Awesome-align model for word alignment in TBM
# Default: {HF_MODELS_DIR}/awesome-align-with-co
# AWESOME_ALIGN_MODEL_PATH=~/HF_models/awesome-align-with-co

# COMET model for translation quality evaluation
# Default: {HF_MODELS_DIR}/wmt22-comet-da
# COMET_MODEL_PATH=~/HF_models/wmt22-comet-da

# =============================================================================
# Tool Paths (Optional)
# =============================================================================

# VecAlign repository for sentence/paragraph alignment
# Default: {project_root}/other_repos/vecalign
# VECALIGN_PATH=~/tools/vecalign

# SEGALE repository (optional, for reference)
# Default: {project_root}/other_repos/SEGALE
# SEGALE_PATH=~/tools/SEGALE

# =============================================================================
# Example Configurations
# =============================================================================
#
# --- Local Development (Mac/Linux) ---
# HF_MODELS_DIR=~/HF_models
# STANZA_RESOURCES_DIR=~/stanza_resources
#
# --- SageMaker with EFS ---
# HF_MODELS_DIR=/mnt/custom-file-systems/efs/HF_models
# STANZA_RESOURCES_DIR=/mnt/custom-file-systems/efs/stanza_resources
#
# --- SageMaker with user-default-efs ---
# HF_MODELS_DIR=~/user-default-efs/HF_models
# STANZA_RESOURCES_DIR=~/user-default-efs/stanza_resources
#
# =============================================================================
